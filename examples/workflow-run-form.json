        "form": "{\n  \"title\": \"Angebot bestätigen\",\n  \"description\": \"Bitte prüfe das Angebot und ergänze die Angaben für den Newsletter.\",\n  \"recipient\": \"customer\",\n  \"remindAfterMinutes\": 1440,\n  \"expiresInMinutes\": 4320,\n  \"submitLabel\": \"Bestätigen\",\n  \"fields\": [\n    {\n      \"key\": \"price_ok\",\n      \"label\": \"Preis von 1.200 EUR bestätigt\",\n      \"type\": \"boolean\",\n      \"required\": true\n    },\n    {\n      \"key\": \"topics\",\n      \"label\": \"Themen für den Newsletter\",\n      \"type\": \"multiselect\",\n      \"options\": [\n        \"Frühling\",\n        \"Veranstaltungen\",\n        \"Team\"\n      ],\n      \"min\": 1,\n      \"max\": 2,\n      \"required\": true\n    },\n    {\n      \"key\": \"tone\",\n      \"label\": \"Ton\",\n      \"type\": \"select\",\n      \"options\": [\n        {\n          \"value\": \"du\",\n          \"label\": \"Du\"\n        },\n        {\n          \"value\": \"sie\",\n          \"label\": \"Sie\"\n        }\n      ],\n      \"default\": \"du\"\n    },\n    {\n      \"key\": \"start\",\n      \"label\": \"Versand ab\",\n      \"type\": \"date\",\n      \"min\": \"2026-11-01\"\n    },\n    {\n      \"key\": \"budget\",\n      \"label\": \"Budget für Anzeigen (EUR)\",\n      \"type\": \"number\",\n      \"min\": 0,\n      \"max\": 10000\n    },\n    {\n      \"key\": \"website\",\n      \"label\": \"Landingpage\",\n      \"type\": \"url\"\n    },\n    {\n      \"key\": \"notes\",\n      \"label\": \"Hinweise\",\n      \"type\": \"textarea\",\n      \"maxLength\": 2000,\n      \"help\": \"Alles, was wir beim Schreiben wissen sollten.\"\n    },\n    {\n      \"key\": \"briefing\",\n      \"label\": \"Briefing (PDF)\",\n      \"type\": \"file\",\n      \"accept\": [\n        \"application/pdf\"\n      ],\n      \"maxSizeMb\": 10\n    }\n  ]\n}",
        "formContext": "={{ JSON.stringify({ angebot: 'Newsletter-Paket', preis: '1.200 EUR' }) }}",
